{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Darpan",
  "colors": {
    "primary": "#1C1C1C",
    "light": "#F2F2F2",
    "dark": "#5F5F5F"
  },
  "favicon": "/favicon-b17b6c3.svg",
  "seo": {
    "metatags": {
      "canonical": "https://docs.drpn.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Product docs",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "getting-started/overview",
              "getting-started/core-concepts",
              "getting-started/ask-darpan-navigation",
              "getting-started/tenant-admin-quickstart"
            ]
          },
          {
            "group": "Set up sources",
            "pages": [
              "guides/connect-sftp",
              "guides/connect-database",
              "guides/connect-netsuite",
              "guides/setup-shopify",
              "guides/setup-hotwax"
            ]
          },
          {
            "group": "Build a run",
            "pages": [
              "guides/create-schema",
              "guides/setup-reconciliation-run",
              "guides/author-rules",
              "guides/run-reconciliation",
              "guides/review-results",
              "guides/returns-and-exchanges",
              "guides/lifecycle-runs",
              "guides/audits"
            ]
          },
          {
            "group": "Admin & alerts",
            "pages": [
              "guides/manage-tenant-settings",
              "guides/manage-users-and-access",
              "guides/setup-automation",
              "guides/run-completion-alerts",
              "guides/configure-ai"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/file-formats",
              "reference/schema-model",
              "reference/composite-matching-keys",
              "reference/reconciliation-runs",
              "reference/glossary",
              "reference/auth-and-access"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/login-and-session",
              "troubleshooting/file-upload",
              "troubleshooting/connections",
              "troubleshooting/reconciliation-runs",
              "troubleshooting/automations-and-alerts"
            ]
          }
        ]
      },
      {
        "tab": "Roadmap & releases",
        "groups": [
          {
            "group": "Roadmap",
            "pages": [
              "releases/roadmap"
            ]
          },
          {
            "group": "Community",
            "pages": [
              "releases/feature-requests",
              "releases/bug-reports"
            ]
          },
          {
            "group": "Release notes",
            "pages": [
              "releases/updates"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Darpan UI",
          "href": "https://github.com/drpn-ai/darpan-ui",
          "icon": "github"
        },
        {
          "anchor": "Darpan backend",
          "href": "https://github.com/drpn-ai/darpan",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light-app-wordmark-v2.svg",
    "dark": "/logo/dark-app-wordmark-v2.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Developers",
        "href": "https://developers.drpn.ai"
      },
      {
        "label": "Back to website",
        "href": "https://drpn.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Darpan",
      "href": "https://app.drpn.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    {
      "source": "/getting-started/set-up-darpan-independently",
      "destination": "https://developers.drpn.ai/self-host/set-up-darpan-independently"
    },
    {
      "source": "/getting-started/environments",
      "destination": "https://developers.drpn.ai/self-host/environments"
    },
    {
      "source": "/getting-started/self-host-production",
      "destination": "https://developers.drpn.ai/self-host/production"
    },
    {
      "source": "/troubleshooting/local-dev-setup",
      "destination": "https://developers.drpn.ai/self-host/troubleshooting"
    },
    {
      "source": "/graphql/:slug*",
      "destination": "https://developers.drpn.ai/graphql/:slug*"
    },
    {
      "source": "/backend/:slug*",
      "destination": "https://developers.drpn.ai/backend/:slug*"
    },
    {
      "source": "/engineering/:slug*",
      "destination": "https://developers.drpn.ai/engineering/:slug*"
    },
    {
      "source": "/api-reference/:slug*",
      "destination": "https://developers.drpn.ai/graphql/overview"
    }
  ]
}
